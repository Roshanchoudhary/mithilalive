{
  "name": "news-portal-cms",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "cf-build": "astro build && wrangler pages deploy dist",
    "deploy": "node scripts/deploy.js",
    "db:migrate": "wrangler d1 migrations apply mithilalive --remote",
    "db:local": "wrangler d1 migrations apply mithilalive --local",
    "db:seed": "node scripts/seed.js",
    "db:migrate:create": "wrangler d1 migrations create mithilalive",
    "format": "prettier --write .",
    "lint": "eslint src/**/*.{ts,astro}"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^10.3.0",
    "@astrojs/tailwind": "^5.1.0",
    "@noble/hashes": "^1.3.3",
    "astro": "^4.5.0",
    "cookie": "^0.6.0",
    "drizzle-orm": "^0.30.10",
    "jose": "^5.2.3",
    "nodemailer": "^6.9.13",
    "sharp": "^0.33.2",
    "slugify": "^1.6.6",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240402.0",
    "@tailwindcss/typography": "^0.5.10",
    "@types/nodemailer": "^6.4.14",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "drizzle-kit": "^0.20.14",
    "eslint": "^8.57.0",
    "eslint-plugin-astro": "^0.31.4",
    "prettier": "^3.2.5",
    "prettier-plugin-astro": "^0.13.0",
    "typescript": "^5.4.2",
    "wrangler": "^3.36.0"
  }
}
