---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/ui/Card.astro';
import { getLatestNews, getFeaturedNews, getTrendingNews, getBreakingNews } from '@/utils/helpers';
import { generateOrganizationSchema } from '@/utils/seo';

const latestNews = await getLatestNews(10);
const featuredNews = await getFeaturedNews(5);
const trendingNews = await getTrendingNews(6);
const breakingNews = await getBreakingNews(3);

const siteName = import.meta.env.SITE_NAME || 'News Portal';
const siteDescription = import.meta.env.SITE_DESCRIPTION || 'Your trusted source for news and updates';
---

<BaseLayout 
  title={siteName} 
  description={siteDescription}
  schema={generateOrganizationSchema()}
>
  <div class="container-custom py-6">
    <!-- Featured/Hero Section -->
    {featuredNews.length > 0 && (
      <section class="mb-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {featuredNews.slice(0, 1).map(news => (
            <a href={`/${news.slug}`} class="group relative overflow-hidden rounded-lg shadow-lg">
              {news.featured_image && (
                <img 
                  src={news.featured_image} 
                  alt={news.title}
                  class="w-full h-64 md:h-96 object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              )}
              <div class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-black via-black/70 to-transparent">
                {news.category && (
                  <span class="inline-block px-2 py-1 bg-primary-600 text-white text-xs font-semibold rounded mb-2">
                    {news.category}
                  </span>
                )}
                <h2 class="text-xl md:text-2xl font-bold text-white group-hover:text-primary-400 transition-colors">
                  {news.title}
                </h2>
                <p class="text-sm text-gray-300 mt-1 line-clamp-2">{news.summary}</p>
              </div>
            </a>
          ))}
          <div class="grid grid-cols-2 gap-3">
            {featuredNews.slice(1, 5).map(news => (
              <a href={`/${news.slug}`} class="group relative overflow-hidden rounded-lg">
                {news.featured_image && (
                  <img 
                    src={news.featured_image} 
                    alt={news.title}
                    class="w-full h-32 md:h-40 object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                )}
                <div class="absolute bottom-0 left-0 right-0 p-3 bg-gradient-to-t from-black to-transparent">
                  <h3 class="text-xs md:text-sm font-semibold text-white group-hover:text-primary-400 transition-colors line-clamp-2">
                    {news.title}
                  </h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main News -->
      <section class="lg:col-span-2">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-2xl font-bold">Latest News</h2>
          <a href="/news" class="text-sm text-primary-600 dark:text-primary-400 hover:underline">View All →</a>
        </div>
        <div class="space-y-4">
          {latestNews.slice(0, 7).map(news => (
            <Card
              title={news.title}
              image={news.featured_image}
              href={`/${news.slug}`}
              category={news.category}
              categoryHref={`/category/${news.category_slug}`}
              date={news.publish_date}
              author={news.author}
              summary={news.summary}
              readingTime={news.reading_time}
              views={news.views}
            />
          ))}
        </div>
      </section>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <!-- Trending -->
        {trendingNews.length > 0 && (
          <div class="card p-4">
            <h3 class="font-bold text-lg mb-3 flex items-center">
              <span class="mr-2">🔥</span> Trending Now
            </h3>
            <div class="space-y-3">
              {trendingNews.slice(0, 5).map((news, index) => (
                <a href={`/${news.slug}`} class="flex items-start gap-3 group">
                  <span class="flex-shrink-0 w-6 text-center font-bold text-primary-600 dark:text-primary-400">
                    {index + 1}
                  </span>
                  <span class="text-sm group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors line-clamp-2">
                    {news.title}
                  </span>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Breaking News -->
        {breakingNews.length > 0 && (
          <div class="card p-4 bg-red-50 dark:bg-red-900/10 border border-red-200 dark:border-red-800">
            <h3 class="font-bold text-lg mb-3 text-red-600 dark:text-red-400 flex items-center">
              <span class="mr-2">🔴</span> Breaking
            </h3>
            <div class="space-y-2">
              {breakingNews.map(news => (
                <a href={`/${news.slug}`} class="block text-sm hover:text-red-600 dark:hover:text-red-400 transition-colors">
                  • {news.title}
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Ad -->
        <div class="card p-4">
          <div class="bg-slate-100 dark:bg-slate-700 h-60 flex items-center justify-center text-slate-400 rounded-lg">
            <div class="text-center">
              <span class="block text-sm">Advertisement</span>
              <span class="text-xs">300x250</span>
            </div>
          </div>
        </div>

        <!-- Newsletter -->
        <div class="card p-4 bg-primary-50 dark:bg-primary-900/20">
          <h3 class="font-bold text-lg mb-2">📧 Subscribe to Newsletter</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">
            Get the latest news delivered to your inbox.
          </p>
          <form id="sidebarNewsletter" class="space-y-3">
            <input 
              type="email" 
              name="email" 
              placeholder="Your email" 
              class="w-full px-3 py-2 rounded-md border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800"
              required
            />
            <button type="submit" class="w-full btn btn-primary">Subscribe</button>
          </form>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  // Sidebar newsletter
  document.getElementById('sidebarNewsletter')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = e.target.querySelector('input[type="email"]').value;
    const button = e.target.querySelector('button');
    const originalText = button.textContent;
    
    try {
      button.textContent = 'Subscribing...';
      button.disabled = true;
      
      const response = await fetch('/api/newsletter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
      });
      
      if (response.ok) {
        alert('Thank you for subscribing!');
        e.target.reset();
      } else {
        throw new Error('Subscription failed');
      }
    } catch {
      alert('Something went wrong. Please try again.');
    } finally {
      button.textContent = originalText;
      button.disabled = false;
    }
  });
</script>

<style is:global>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
