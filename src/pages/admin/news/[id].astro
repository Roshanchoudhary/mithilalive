---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getSession } from '@/middleware/auth';
import { createDb } from '@/db/index';

const user = await getSession(Astro.request);
if (!user || !['super_admin', 'admin'].includes(user.role)) {
  return Astro.redirect('/admin/login');
}

const { id } = Astro.params;
const db = createDb();

// Get news article
const newsResult = await db.execute({
  sql: `
    SELECT n.*, u.name as author_name, c.name as category_name
    FROM news n
    LEFT JOIN users u ON n.author_id = u.id
    LEFT JOIN categories c ON n.category_id = c.id
    WHERE n.id = ?
  `,
  args: [parseInt(id)]
});

if (!newsResult.results || newsResult.results.length === 0) {
  return Astro.redirect('/admin/news');
}

const news = newsResult.results[0];

// Get categories
const categories = await db.execute({
  sql: `SELECT id, name FROM categories WHERE is_active = 1 ORDER BY name ASC`
});

// Get tags
const tagsResult = await db.execute({
  sql: `
    SELECT t.name FROM tags t
    INNER JOIN news_tags nt ON t.id = nt.tag_id
    WHERE nt.news_id = ?
  `,
  args: [parseInt(id)]
});

const tags = tagsResult.results || [];
---

<AdminLayout title="Edit News">
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Edit Article</h1>
      <a href="/admin/news" class="btn btn-secondary">← Back to News</a>
    </div>

    <form id="newsForm" class="bg-white dark:bg-slate-800 rounded-lg shadow p-6 space-y-6">
      <!-- Title -->
      <div>
        <label for="title" class="label">Title *</label>
        <input type="text" id="title" name="title" class="input" value={news.title} required />
      </div>

      <!-- Slug -->
      <div>
        <label for="slug" class="label">Slug</label>
        <input type="text" id="slug" name="slug" class="input" value={news.slug} />
      </div>

      <!-- Category -->
      <div>
        <label for="category" class="label">Category</label>
        <select id="category" name="category" class="input">
          <option value="">Select Category</option>
          {categories.results?.map(cat => (
            <option key={cat.id} value={cat.id} selected={cat.id === news.category_id}>
              {cat.name}
            </option>
          ))}
        </select>
      </div>

      <!-- Author -->
      <div>
        <label class="label">Author</label>
        <p class="text-slate-600 dark:text-slate-300">{news.author_name || 'Unknown'}</p>
      </div>

      <!-- Summary -->
      <div>
        <label for="summary" class="label">Summary</label>
        <textarea id="summary" name="summary" rows="3" class="input">{news.summary || ''}</textarea>
      </div>

      <!-- Content -->
      <div>
        <label for="content" class="label">Content *</label>
        <textarea id="content" name="content" rows="15" class="input font-mono text-sm" required>{news.content}</textarea>
      </div>

      <!-- Featured Image -->
      <div>
        <label for="featuredImage" class="label">Featured Image URL</label>
        <input type="url" id="featuredImage" name="featuredImage" class="input" value={news.featured_image || ''} />
      </div>

      <!-- Tags -->
      <div>
        <label for="tags" class="label">Tags</label>
        <input type="text" id="tags" name="tags" class="input" value={tags.map(t => t.name).join(', ')} />
      </div>

      <!-- Status -->
      <div>
        <label for="status" class="label">Status</label>
        <select id="status" name="status" class="input">
          <option value="draft" selected={news.status === 'draft'}>Draft</option>
          <option value="pending" selected={news.status === 'pending'}>Pending Review</option>
          <option value="published" selected={news.status === 'published'}>Published</option>
          <option value="rejected" selected={news.status === 'rejected'}>Rejected</option>
          <option value="archived" selected={news.status === 'archived'}>Archived</option>
        </select>
      </div>

      <!-- Featured/Sticky/Etc -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <label class="flex items-center space-x-2">
          <input type="checkbox" name="isFeatured" value="1" checked={news.is_featured === 1} />
          <span class="text-sm">Featured</span>
        </label>
        <label class="flex items-center space-x-2">
          <input type="checkbox" name="isBreaking" value="1" checked={news.is_breaking === 1} />
          <span class="text-sm">Breaking</span>
        </label>
        <label class="flex items-center space-x-2">
          <input type="checkbox" name="isSticky" value="1" checked={news.is_sticky === 1} />
          <span class="text-sm">Sticky</span>
        </label>
        <label class="flex items-center space-x-2">
          <input type="checkbox" name="isTrending" value="1" checked={news.is_trending === 1} />
          <span class="text-sm">Trending</span>
        </label>
      </div>

      <!-- SEO Fields -->
      <details class="border border-slate-200 dark:border-slate-700 rounded-lg p-4">
        <summary class="cursor-pointer font-medium text-slate-700 dark:text-slate-300">SEO Settings (Optional)</summary>
        <div class="mt-4 space-y-4">
          <div>
            <label for="seoTitle" class="label">SEO Title</label>
            <input type="text" id="seoTitle" name="seoTitle" class="input" value={news.seo_title || ''} />
          </div>
          <div>
            <label for="seoDescription" class="label">SEO Description</label>
            <textarea id="seoDescription" name="seoDescription" rows="2" class="input">{news.seo_description || ''}</textarea>
          </div>
          <div>
            <label for="keywords" class="label">Keywords</label>
            <input type="text" id="keywords" name="keywords" class="input" value={news.keywords || ''} />
          </div>
        </div>
      </details>

      <!-- Submit -->
      <div class="flex gap-3">
        <button type="submit" class="btn btn-primary">Update Article</button>
        <button type="button" onclick="deleteNews()" class="btn btn-danger">Delete</button>
        <button type="button" onclick="window.location.href='/admin/news'" class="btn btn-secondary">Cancel</button>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  const newsId = parseInt('${id}');

  document.getElementById('newsForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const formData = new FormData(form);

    const data = {
      title: formData.get('title'),
      slug: formData.get('slug'),
      category_id: parseInt(formData.get('category')) || null,
      summary: formData.get('summary'),
      content: formData.get('content'),
      featured_image: formData.get('featuredImage'),
      tags: formData.get('tags')?.split(',').map(t => t.trim()).filter(Boolean) || [],
      status: formData.get('status'),
      is_featured: formData.get('isFeatured') ? 1 : 0,
      is_breaking: formData.get('isBreaking') ? 1 : 0,
      is_sticky: formData.get('isSticky') ? 1 : 0,
      is_trending: formData.get('isTrending') ? 1 : 0,
      seo_title: formData.get('seoTitle'),
      seo_description: formData.get('seoDescription'),
      keywords: formData.get('keywords')
    };

    const button = form.querySelector('button[type="submit"]');
    const originalText = button.textContent;
    button.textContent = 'Updating...';
    button.disabled = true;

    try {
      const response = await fetch(`/api/news/${newsId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      const result = await response.json();

      if (response.ok) {
        alert('Article updated successfully!');
        window.location.href = '/admin/news';
      } else {
        alert(result.error || 'Failed to update article');
      }
    } catch {
      alert('Network error. Please try again.');
    } finally {
      button.textContent = originalText;
      button.disabled = false;
    }
  });

  async function deleteNews() {
    if (!confirm('Are you sure you want to delete this article?')) return;

    try {
      const response = await fetch(`/api/news/${newsId}`, {
        method: 'DELETE'
      });

      if (response.ok) {
        window.location.href = '/admin/news';
      } else {
        alert('Failed to delete article');
      }
    } catch {
      alert('Network error. Please try again.');
    }
  }
</script>
