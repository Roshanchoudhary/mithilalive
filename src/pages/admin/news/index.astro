---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getSession } from '@/middleware/auth';
import { createDb } from '@/db/index';

const user = await getSession(Astro.request);
if (!user || !['super_admin', 'admin'].includes(user.role)) {
  return Astro.redirect('/admin/login');
}

const db = createDb();
const url = new URL(Astro.request.url);
const status = url.searchParams.get('status') || 'all';
const search = url.searchParams.get('search') || '';

let sql = `
  SELECT n.*, u.name as author_name, c.name as category_name
  FROM news n
  LEFT JOIN users u ON n.author_id = u.id
  LEFT JOIN categories c ON n.category_id = c.id
  WHERE 1=1
`;
const args: any[] = [];

if (status !== 'all') {
  sql += ` AND n.status = ?`;
  args.push(status);
}

if (search) {
  sql += ` AND (n.title LIKE ? OR n.content LIKE ?)`;
  const searchTerm = `%${search}%`;
  args.push(searchTerm, searchTerm);
}

sql += ` ORDER BY n.created_at DESC LIMIT 50`;

const newsResult = await db.execute({ sql, args });

// Get stats
const statsResult = await db.execute({
  sql: `
    SELECT 
      COUNT(*) as total,
      SUM(CASE WHEN status = 'published' THEN 1 ELSE 0 END) as published,
      SUM(CASE WHEN status = 'pending' THEN 1 ELSE 0 END) as pending,
      SUM(CASE WHEN status = 'draft' THEN 1 ELSE 0 END) as draft,
      SUM(CASE WHEN status = 'rejected' THEN 1 ELSE 0 END) as rejected
    FROM news
  `
});

const stats = statsResult.results?.[0] || { total: 0, published: 0, pending: 0, draft: 0, rejected: 0 };
---

<AdminLayout title="News Management">
  <div class="space-y-6">
    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
        <p class="text-sm text-slate-500 dark:text-slate-400">Total</p>
        <p class="text-2xl font-bold text-slate-900 dark:text-white">{stats.total}</p>
      </div>
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
        <p class="text-sm text-slate-500 dark:text-slate-400">Published</p>
        <p class="text-2xl font-bold text-green-600 dark:text-green-400">{stats.published}</p>
      </div>
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
        <p class="text-sm text-slate-500 dark:text-slate-400">Pending</p>
        <p class="text-2xl font-bold text-yellow-600 dark:text-yellow-400">{stats.pending}</p>
      </div>
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
        <p class="text-sm text-slate-500 dark:text-slate-400">Draft</p>
        <p class="text-2xl font-bold text-blue-600 dark:text-blue-400">{stats.draft}</p>
      </div>
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
        <p class="text-sm text-slate-500 dark:text-slate-400">Rejected</p>
        <p class="text-2xl font-bold text-red-600 dark:text-red-400">{stats.rejected}</p>
      </div>
    </div>

    <!-- Filters -->
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
      <div class="flex flex-wrap gap-4 items-center">
        <div class="flex gap-2">
          <a href="/admin/news" class={`px-3 py-1 rounded-md text-sm ${status === 'all' ? 'bg-primary-600 text-white' : 'bg-slate-100 dark:bg-slate-700 hover:bg-slate-200'}`}>All</a>
          <a href="/admin/news?status=published" class={`px-3 py-1 rounded-md text-sm ${status === 'published' ? 'bg-primary-600 text-white' : 'bg-slate-100 dark:bg-slate-700 hover:bg-slate-200'}`}>Published</a>
          <a href="/admin/news?status=pending" class={`px-3 py-1 rounded-md text-sm ${status === 'pending' ? 'bg-primary-600 text-white' : 'bg-slate-100 dark:bg-slate-700 hover:bg-slate-200'}`}>Pending</a>
          <a href="/admin/news?status=draft" class={`px-3 py-1 rounded-md text-sm ${status === 'draft' ? 'bg-primary-600 text-white' : 'bg-slate-100 dark:bg-slate-700 hover:bg-slate-200'}`}>Draft</a>
          <a href="/admin/news?status=rejected" class={`px-3 py-1 rounded-md text-sm ${status === 'rejected' ? 'bg-primary-600 text-white' : 'bg-slate-100 dark:bg-slate-700 hover:bg-slate-200'}`}>Rejected</a>
        </div>
        <div class="flex-1">
          <form method="GET" class="flex gap-2">
            <input type="hidden" name="status" value={status} />
            <input type="search" name="search" value={search} placeholder="Search news..." class="flex-1 input" />
            <button type="submit" class="btn btn-primary">Search</button>
          </form>
        </div>
        <a href="/admin/news/create" class="btn btn-primary">+ Create News</a>
      </div>
    </div>

    <!-- News List -->
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow overflow-hidden">
      <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-700">
        <thead class="bg-slate-50 dark:bg-slate-700">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-300 uppercase tracking-wider">Title</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-300 uppercase tracking-wider">Author</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-300 uppercase tracking-wider">Category</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-300 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-300 uppercase tracking-wider">Date</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 dark:text-slate-300 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white dark:bg-slate-800 divide-y divide-slate-200 dark:divide-slate-700">
          {newsResult.results && newsResult.results.length > 0 ? (
            newsResult.results.map(item => (
              <tr key={item.id} class="hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors">
                <td class="px-6 py-4">
                  <a href={`/admin/news/${item.id}`} class="text-sm font-medium text-slate-900 dark:text-white hover:text-primary-600">
                    {item.title}
                  </a>
                </td>
                <td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-300">{item.author_name || 'Unknown'}</td>
                <td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-300">{item.category_name || '-'}</td>
                <td class="px-6 py-4">
                  <span class={`badge ${item.status === 'published' ? 'badge-success' : item.status === 'pending' ? 'badge-warning' : item.status === 'rejected' ? 'badge-danger' : 'badge-info'}`}>
                    {item.status.charAt(0).toUpperCase() + item.status.slice(1)}
                  </span>
                </td>
                <td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-300">
                  {new Date(item.created_at * 1000).toLocaleDateString()}
                </td>
                <td class="px-6 py-4 text-right text-sm space-x-2">
                  <a href={`/admin/news/${item.id}`} class="text-primary-600 hover:text-primary-700">Edit</a>
                  <button onclick="deleteNews(${item.id})" class="text-red-600 hover:text-red-700">Delete</button>
                </td>
              </tr>
            ))
          ) : (
            <tr>
              <td colspan="6" class="px-6 py-8 text-center text-slate-500 dark:text-slate-400">
                No news articles found
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<script>
  async function deleteNews(id) {
    if (!confirm('Are you sure you want to delete this article?')) return;

    try {
      const response = await fetch(`/api/news/${id}`, {
        method: 'DELETE'
      });

      if (response.ok) {
        location.reload();
      } else {
        alert('Failed to delete article');
      }
    } catch {
      alert('Network error. Please try again.');
    }
  }
</script>
