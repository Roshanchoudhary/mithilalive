---
import EmployeeLayout from '@/layouts/EmployeeLayout.astro';
import { getSession } from '@/middleware/auth';
import { createDb } from '@/db/index';

const user = await getSession(Astro.request);
if (!user || !['employee', 'editor', 'reporter'].includes(user.role)) {
  return Astro.redirect('/employee/login');
}

const { id } = Astro.params;
const db = createDb();

// Get the news article
const newsResult = await db.execute({
  sql: `
    SELECT n.*, c.name as category_name
    FROM news n
    LEFT JOIN categories c ON n.category_id = c.id
    WHERE n.id = ? AND n.author_id = ?
  `,
  args: [parseInt(id), user.id]
});

if (!newsResult.results || newsResult.results.length === 0) {
  return Astro.redirect('/employee/news');
}

const news = newsResult.results[0];

// Get categories for dropdown
const categories = await db.execute({
  sql: `SELECT id, name FROM categories WHERE is_active = 1 ORDER BY name ASC`
});

// Get tags
const tagsResult = await db.execute({
  sql: `
    SELECT t.name FROM tags t
    INNER JOIN news_tags nt ON t.id = nt.tag_id
    WHERE nt.news_id = ?
  `,
  args: [parseInt(id)]
});

const tags = tagsResult.results || [];
---

<EmployeeLayout title="Edit Article">
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Edit Article</h1>
      <a href="/employee/news" class="btn btn-secondary">← Back to My Articles</a>
    </div>

    <form id="newsForm" class="bg-white dark:bg-slate-800 rounded-lg shadow p-6 space-y-6">
      <!-- Title -->
      <div>
        <label for="title" class="label">Title *</label>
        <input 
          type="text" 
          id="title" 
          name="title" 
          class="input" 
          value={news.title}
          required
        />
      </div>

      <!-- Category -->
      <div>
        <label for="category" class="label">Category</label>
        <select id="category" name="category" class="input">
          <option value="">Select Category</option>
          {categories.results?.map(cat => (
            <option key={cat.id} value={cat.id} selected={cat.id === news.category_id}>
              {cat.name}
            </option>
          ))}
        </select>
      </div>

      <!-- Summary -->
      <div>
        <label for="summary" class="label">Summary</label>
        <textarea 
          id="summary" 
          name="summary" 
          rows="3" 
          class="input"
        >{news.summary || ''}</textarea>
      </div>

      <!-- Content -->
      <div>
        <label for="content" class="label">Content *</label>
        <textarea 
          id="content" 
          name="content" 
          rows="15" 
          class="input font-mono text-sm"
          required
        >{news.content}</textarea>
      </div>

      <!-- Featured Image -->
      <div>
        <label for="featuredImage" class="label">Featured Image URL</label>
        <input 
          type="url" 
          id="featuredImage" 
          name="featuredImage" 
          class="input" 
          value={news.featured_image || ''}
        />
      </div>

      <!-- Tags -->
      <div>
        <label for="tags" class="label">Tags</label>
        <input 
          type="text" 
          id="tags" 
          name="tags" 
          class="input" 
          value={tags.map(t => t.name).join(', ')}
          placeholder="tag1, tag2, tag3"
        />
      </div>

      <!-- Status -->
      <div>
        <label class="label">Current Status</label>
        <div class="flex items-center gap-2">
          <span class={`badge ${
            news.status === 'published' ? 'badge-success' :
            news.status === 'pending' ? 'badge-warning' :
            news.status === 'rejected' ? 'badge-danger' :
            'badge-info'
          }`}>
            {news.status.charAt(0).toUpperCase() + news.status.slice(1)}
          </span>
          {news.status === 'rejected' && (
            <span class="text-sm text-red-600 dark:text-red-400">
              - Please make changes and resubmit
            </span>
          )}
        </div>
      </div>

      <!-- SEO Fields -->
      <details class="border border-slate-200 dark:border-slate-700 rounded-lg p-4">
        <summary class="cursor-pointer font-medium text-slate-700 dark:text-slate-300">
          SEO Settings (Optional)
        </summary>
        <div class="mt-4 space-y-4">
          <div>
            <label for="seoTitle" class="label">SEO Title</label>
            <input type="text" id="seoTitle" name="seoTitle" class="input" value={news.seo_title || ''} />
          </div>
          <div>
            <label for="seoDescription" class="label">SEO Description</label>
            <textarea id="seoDescription" name="seoDescription" rows="2" class="input">{news.seo_description || ''}</textarea>
          </div>
          <div>
            <label for="keywords" class="label">Keywords</label>
            <input type="text" id="keywords" name="keywords" class="input" value={news.keywords || ''} />
          </div>
        </div>
      </details>

      <!-- Submit -->
      <div class="flex gap-3">
        {news.status === 'draft' && (
          <button type="submit" name="action" value="draft" class="btn btn-secondary">
            Update Draft
          </button>
        )}
        {['draft', 'rejected'].includes(news.status) && (
          <button type="submit" name="action" value="pending" class="btn btn-primary">
            Submit for Review
          </button>
        )}
        {news.status === 'pending' && (
          <button type="button" class="btn btn-secondary" disabled>
            Awaiting Review
          </button>
        )}
        {news.status === 'published' && (
          <button type="submit" name="action" value="published" class="btn btn-success">
            Update Published
          </button>
        )}
        <button type="button" onclick="deleteNews()" class="btn btn-danger">
          Delete
        </button>
      </div>
    </form>
  </div>
</EmployeeLayout>

<script>
  const newsId = parseInt('${id}');

  document.getElementById('newsForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const formData = new FormData(form);
    const action = form.querySelector('button[clicked]')?.value || 'draft';

    const data = {
      title: formData.get('title'),
      category_id: parseInt(formData.get('category')) || null,
      summary: formData.get('summary'),
      content: formData.get('content'),
      featured_image: formData.get('featuredImage'),
      tags: formData.get('tags')?.split(',').map(t => t.trim()).filter(Boolean) || [],
      seo_title: formData.get('seoTitle'),
      seo_description: formData.get('seoDescription'),
      keywords: formData.get('keywords'),
      status: action
    };

    const button = form.querySelector('button[type="submit"]');
    const originalText = button.textContent;
    button.textContent = 'Saving...';
    button.disabled = true;

    try {
      const response = await fetch(`/api/news/${newsId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      const result = await response.json();

      if (response.ok) {
        alert('Article updated successfully!');
        window.location.href = '/employee/news';
      } else {
        alert(result.error || 'Failed to update article');
      }
    } catch {
      alert('Network error. Please try again.');
    } finally {
      button.textContent = originalText;
      button.disabled = false;
    }
  });

  // Track which button was clicked
  document.querySelectorAll('button[name="action"]').forEach(btn => {
    btn.addEventListener('click', function() {
      document.querySelectorAll('button[name="action"]').forEach(b => b.removeAttribute('clicked'));
      this.setAttribute('clicked', 'true');
    });
  });

  async function deleteNews() {
    if (!confirm('Are you sure you want to delete this article?')) return;

    try {
      const response = await fetch(`/api/news/${newsId}`, {
        method: 'DELETE'
      });

      if (response.ok) {
        window.location.href = '/employee/news';
      } else {
        alert('Failed to delete article');
      }
    } catch {
      alert('Network error. Please try again.');
    }
  }
</script>
