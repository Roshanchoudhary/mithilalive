---
export interface Props {
  title?: string;
  image?: string;
  imageAlt?: string;
  href?: string;
  category?: string;
  categoryHref?: string;
  date?: string;
  author?: string;
  authorHref?: string;
  summary?: string;
  tags?: Array<{ name: string; slug: string }>;
  readingTime?: number;
  views?: number;
  featured?: boolean;
  className?: string;
  imagePosition?: 'top' | 'left' | 'right' | 'bottom';
}

const {
  title,
  image,
  imageAlt = '',
  href,
  category,
  categoryHref,
  date,
  author,
  authorHref,
  summary,
  tags = [],
  readingTime,
  views,
  featured = false,
  className = '',
  imagePosition = 'top'
} = Astro.props;

const cardClasses = `card ${className} ${featured ? 'border-2 border-primary-500' : ''}`;

function formatDate(dateStr: string) {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<div class={cardClasses}>
  {image && (
    <div class={`overflow-hidden ${imagePosition === 'top' ? 'w-full' : 'w-full md:w-48 flex-shrink-0'}`}>
      {href ? (
        <a href={href}>
          <img 
            src={image} 
            alt={imageAlt || title} 
            class="w-full h-48 md:h-64 object-cover hover:scale-105 transition-transform duration-300"
            loading="lazy"
          />
        </a>
      ) : (
        <img 
          src={image} 
          alt={imageAlt || title} 
          class="w-full h-48 md:h-64 object-cover"
          loading="lazy"
        />
      )}
    </div>
  )}
  
  <div class={`p-4 ${imagePosition === 'left' || imagePosition === 'right' ? 'flex-1' : ''}`}>
    {category && (
      <a 
        href={categoryHref || `/category/${category.toLowerCase().replace(/\s+/g, '-')}`}
        class="inline-block text-xs font-semibold text-primary-600 dark:text-primary-400 hover:underline mb-2"
      >
        {category}
      </a>
    )}
    
    {href ? (
      <a href={href} class="block">
        <h3 class={`font-bold hover:text-primary-600 dark:hover:text-primary-400 transition-colors ${featured ? 'text-xl md:text-2xl' : 'text-lg'}`}>
          {title}
        </h3>
      </a>
    ) : (
      <h3 class={`font-bold ${featured ? 'text-xl md:text-2xl' : 'text-lg'}`}>
        {title}
      </h3>
    )}
    
    {summary && (
      <p class="text-sm text-slate-600 dark:text-slate-400 mt-2 line-clamp-3">
        {summary}
      </p>
    )}
    
    <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mt-3">
      {date && <time dateTime={date}>{formatDate(date)}</time>}
      {date && readingTime && <span>•</span>}
      {readingTime && <span>{readingTime} min read</span>}
      {readingTime && views && <span>•</span>}
      {views && <span>{views} views</span>}
      {author && (
        <>
          <span>•</span>
          <a href={authorHref || `/author/${author.toLowerCase().replace(/\s+/g, '-')}`} class="hover:text-primary-600 dark:hover:text-primary-400">
            {author}
          </a>
        </>
      )}
    </div>
    
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1 mt-3">
        {tags.map(tag => (
          <a 
            key={tag.slug} 
            href={`/tag/${tag.slug}`}
            class="text-xs px-2 py-1 bg-slate-100 dark:bg-slate-700 rounded-full hover:bg-primary-100 dark:hover:bg-primary-900 transition-colors"
          >
            #{tag.name}
          </a>
        ))}
      </div>
    )}
  </div>
</div>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
