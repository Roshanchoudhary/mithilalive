---
export interface Props {
  id: string;
  title?: string;
  open?: boolean;
  onClose?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  className?: string;
}

const { 
  id, 
  title, 
  open = false, 
  onClose = 'closeModal', 
  size = 'md',
  className = '' 
} = Astro.props;

const sizeClasses = {
  sm: 'max-w-md',
  md: 'max-w-lg',
  lg: 'max-w-2xl',
  xl: 'max-w-4xl'
};
---

<div 
  id={id} 
  class={`fixed inset-0 z-50 flex items-center justify-center p-4 ${open ? '' : 'hidden'}`}
  role="dialog"
  aria-modal="true"
  aria-labelledby={`${id}-title`}
>
  <!-- Backdrop -->
  <div 
    class="fixed inset-0 bg-black/50 backdrop-blur-sm" 
    id={`${id}-backdrop`}
    onClick={onClose}
  ></div>
  
  <!-- Modal -->
  <div class={`relative bg-white dark:bg-slate-800 rounded-lg shadow-xl w-full ${sizeClasses[size]} ${className} animate-slide-down`}>
    <!-- Header -->
    {(title || onClose) && (
      <div class="flex items-center justify-between p-4 border-b border-slate-200 dark:border-slate-700">
        {title && <h3 id={`${id}-title`} class="text-lg font-semibold text-slate-900 dark:text-slate-100">{title}</h3>}
        {onClose && (
          <button 
            onClick={onClose}
            class="p-1 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors"
            aria-label="Close modal"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        )}
      </div>
    )}
    
    <!-- Body -->
    <div class="p-6">
      <slot />
    </div>
    
    <!-- Footer -->
    {Astro.slots.has('footer') && (
      <div class="flex justify-end gap-2 p-4 border-t border-slate-200 dark:border-slate-700">
        <slot name="footer" />
      </div>
    )}
  </div>
</div>

<script>
  // Close modal on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const modals = document.querySelectorAll('[role="dialog"]:not(.hidden)');
      modals.forEach(modal => {
        const closeBtn = modal.querySelector('[aria-label="Close modal"]');
        if (closeBtn) closeBtn.click();
      });
    }
  });

  // Close modal on backdrop click
  document.addEventListener('click', (e) => {
    if (e.target.classList.contains('fixed') && e.target.classList.contains('inset-0')) {
      const backdrop = e.target;
      const modal = backdrop.parentElement?.querySelector('[role="dialog"]');
      if (modal) {
        const closeBtn = modal.querySelector('[aria-label="Close modal"]');
        if (closeBtn) closeBtn.click();
      }
    }
  });

  // Expose closeModal function globally
  window.closeModal = (id) => {
    const modal = document.getElementById(id);
    if (modal) {
      modal.classList.add('hidden');
      // Remove backdrop if it exists
      const backdrop = document.getElementById(`${id}-backdrop`);
      if (backdrop) backdrop.remove();
    }
  };

  // Expose openModal function globally
  window.openModal = (id) => {
    const modal = document.getElementById(id);
    if (modal) {
      modal.classList.remove('hidden');
    }
  };
</script>
