{
  "compatibility_date": "2024-04-05",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build",
    "cwd": ".",
    "watch_dir": "src"
  },
  "env": {
    "production": {
      "vars": {
        "NODE_ENV": "production",
        "API_URL": "https://your-domain.com/api"
      }
    },
    "staging": {
      "vars": {
        "NODE_ENV": "staging",
        "API_URL": "https://staging.your-domain.com/api"
      }
    }
  }
}
